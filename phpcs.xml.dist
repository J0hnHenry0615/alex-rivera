<?xml version="1.0"?>
<ruleset name="Rivera">
	<description>WordPress coding standards for the Rivera theme.</description>

	<file>./rivera</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.6"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rivera"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rivera"/>
			</property>
		</properties>
		<!-- Core includes pattern files inside a function, so their variables are local, not global. -->
		<exclude-pattern>/rivera/patterns/*</exclude-pattern>
	</rule>
</ruleset>
