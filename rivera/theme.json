{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "White", "color": "#ffffff" },
				{ "slug": "surface", "name": "Light grey", "color": "#f5f5f6" },
				{ "slug": "contrast", "name": "Ink", "color": "#25252c" },
				{ "slug": "charcoal", "name": "Charcoal", "color": "#31313a" },
				{ "slug": "muted", "name": "Muted", "color": "#5c5c66" },
				{ "slug": "primary", "name": "Navy", "color": "#2d3c8c" },
				{ "slug": "primary-dark", "name": "Navy dark", "color": "#1f2b68" },
				{ "slug": "accent", "name": "Red", "color": "#c8202f" },
				{ "slug": "line", "name": "Line", "color": "#e4e4e8" },
				{ "slug": "focus", "name": "Focus", "color": "#c8202f" }
			],
			"gradients": [
				{
					"slug": "soft",
					"name": "Soft",
					"gradient": "linear-gradient(115deg, #e6efe9 0%, #f6f3ec 55%, #f9e6e0 100%)"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "card", "name": "Card", "shadow": "0 1px 3px rgb(37 37 44 / 0.08), 0 6px 18px -8px rgb(37 37 44 / 0.14)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-latin.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3rem", "fluid": { "min": "2.125rem", "max": "3rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "clamp(1.25rem, 3vw, 1.75rem)" },
				{ "slug": "40", "name": "L", "size": "clamp(1.75rem, 5vw, 3rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2.5rem, 8vw, 5.5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|montserrat",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.1" }
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|x-large" }
			},
			"h3": {
				"typography": { "fontSize": "var:preset|font-size|large" }
			},
			"link": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|primary-dark" },
					"typography": { "textDecoration": "none" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "3px",
					"width": "2px",
					"style": "solid",
					"color": "var:preset|color|primary"
				},
				"spacing": {
					"padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" }
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "700",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": { "background": "var:preset|color|primary-dark" },
					"border": { "color": "var:preset|color|primary-dark" }
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var:preset|color|primary"
						},
						"border": { "color": "var:preset|color|primary", "width": "2px" },
						"spacing": {
							"padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" }
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "700",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
